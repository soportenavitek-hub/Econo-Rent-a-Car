# Copia estos valores tal cual a las Environment Variables en Render
# (o a un archivo .env si corres el proxy en tu propio servidor).

PILOT_SERVER=https://global.pilot-gps.com
PILOT_USER=tu_usuario
PILOT_PASS=tu_contraseña

# Puerto: Render lo asigna automáticamente, puedes omitir esta línea en producción.
PORT=3000

# Origen permitido para CORS. En producción, mejor poner el dominio exacto
# de este despliegue una vez que lo tengas (ej. https://tu-tablero.onrender.com).
ALLOWED_ORIGIN=*

# Token rotativo (cambia solo cada trimestre calendario) — clave fija, nunca la cambies.
# Genera el tuyo con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_SECRET=cambia_esto_por_un_valor_aleatorio

# Clave para consultar el link vigente en /admin/link?key=ESTO (solo para ti, no la compartas).
# Genera la tuya con: node -e "console.log(require('crypto').randomBytes(16).toString('base64url'))"
ADMIN_KEY=cambia_esto_por_otro_valor_aleatorio

# === Login con Microsoft (opcional) ===
# Si dejas estas tres vacías, el tablero sigue funcionando solo con el link
# de token rotativo de arriba, sin login de Microsoft.
#
# MS_CLIENT_ID y MS_CLIENT_SECRET se obtienen registrando una app en:
# https://portal.azure.com → Microsoft Entra ID → App registrations → New registration
# En esa misma app, en "Authentication", agrega como Redirect URI:
#   https://TU-DOMINIO-REAL/auth/microsoft/callback
# (tiene que coincidir exacto con MS_REDIRECT_URI de aquí abajo, o con el
# dominio real si dejas MS_REDIRECT_URI vacío).
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Tenant ID de tu organización en Azure (si lo dejas en "common", cualquier
# cuenta de Microsoft puede intentar el login — igual se filtra por dominio
# de correo con ALLOWED_EMAIL_DOMAIN, pero es más estricto usar tu Tenant ID
# real si lo tienes).
MS_TENANT_ID=common

# Opcional: si no la pones, se arma sola como https://<tu-dominio>/auth/microsoft/callback
MS_REDIRECT_URI=

# Dominio de correo permitido (demo actual: navi-tek.net)
ALLOWED_EMAIL_DOMAIN=navi-tek.net
