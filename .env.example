# Copia este archivo como .env (local) o configura estas mismas variables
# como "Environment Variables" en el panel de Render/Railway/Fly.io.

PILOT_SERVER=https://global.pilot-gps.com
PILOT_USER=monitoreoecono2@econorentacar.com
PILOT_PASS=rgUBK9

# Puerto: en Render/Railway normalmente lo asignan ellos automáticamente
# (dejan su propia variable PORT), así que puedes omitir esta línea en producción.
PORT=3000

# En producción, pon aquí la URL exacta de tu tablero una vez que la tengas
# (ej. https://tu-tablero.onrender.com). En pruebas locales puedes dejar *.
ALLOWED_ORIGIN=*

# Token secreto ROTATIVO para compartir el tablero por link.
# El sistema calcula solo un token distinto cada trimestre calendario
# (Q1: ene-mar, Q2: abr-jun, Q3: jul-sep, Q4: oct-dic) a partir de este
# secreto fijo — tú nunca lo cambias, solo vuelves a compartir el link
# vigente cada 3 meses (consúltalo en /admin/link?key=TU_ADMIN_KEY).
# Genera el tuyo con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_SECRET=cEDg4DUCCcsepLFAJzBCAm8lgHb9XIaF4AuAofL85Gs

# Clave para consultar el link vigente en /admin/link?key=ESTO (no la compartas
# con los 500 usuarios, es solo para ti).
# Genera la tuya con: node -e "console.log(require('crypto').randomBytes(16).toString('base64url'))"
ADMIN_KEY=94STKTHqD1F1K6-MEU_TGQ
